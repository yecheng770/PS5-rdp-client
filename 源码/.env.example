# 构建与部署参数（复制为本目录下的 .env 后按需修改；.env 不入库）
# DEPLOY_DRY_RUN=1 时 tools/build.sh 只构建不部署，安全试手
PS5_HOST=192.168.0.xxx
FTP_PORT=2121
DEPLOY_DRY_RUN=1

# 头文件与静态库路径（FreeRDP 3.33.1 / OpenSSL 1.1.1w / zlib 1.3.1 预编译件，随仓库附带）
APP_INCLUDE_PATHS=vendor/include
APP_STATIC_ARCHIVES=vendor/lib/libfreerdp3.a vendor/lib/libwinpr3.a vendor/lib/libssl.a vendor/lib/libcrypto.a vendor/lib/libz.a vendor/lib/libc.a vendor/lib/libpthread.a vendor/lib/libunwind_noext.a

# 鼠标输入链接需要的只读 stub（libSceMouse 在上游 SDK 里缺失）
# 构建时通过 APP_IMPORT_STUBS 挂入
APP_IMPORT_STUBS=tooling/link-stubs/libSceMouse.so
